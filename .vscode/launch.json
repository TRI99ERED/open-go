    {
      "name": "OpenGo: Profile",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/go_app/lib/main.dart",
      "cwd": "${workspaceFolder}/go_app",
      "flutterMode": "profile"
    },
    {
      "name": "OpenGo: Release",
      "request": "launch",
      "type": "dart",
      "program": "${workspaceFolder}/go_app/lib/main.dart",
      "cwd": "${workspaceFolder}/go_app",
      "flutterMode": "release"
    }
  ]
}
